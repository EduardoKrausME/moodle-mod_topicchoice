{{!
    @template mod_topicchoice/topic_list

    Example context (json):
    {
        *Example context (json):*
    }
}}
<div class="mod-topicchoice">
    {{#hascurrent}}
        <div class="alert alert-info mb-3"><strong>{{currentlabel}}:</strong> {{{current}}}</div>
    {{/hascurrent}}

    <div class="topicchoice-grid">
        {{#items}}
            <div class="topicchoice-card {{#chosen}}topicchoice-card-selected{{/chosen}} {{#full}}topicchoice-card-full{{/full}}">
                <div class="topicchoice-card-body">
                    <h3 class="h5 mb-2">{{{name}}}</h3>
                    {{#showavailability}}
                        <div class="text-muted small mb-3">{{availabilitylabel}}: {{available}}
                            / {{maxstudents}} {{placeslabel}}</div>
                    {{/showavailability}}
                    <form method="post" action="{{action}}" class="mb-0">
                        <input type="hidden" name="id" value="{{cmid}}">
                        <input type="hidden" name="topicid" value="{{id}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <button type="submit"
                                class="btn {{#chosen}}btn-success{{/chosen}}{{^chosen}}btn-primary{{/chosen}}"
                                {{#disabled}}disabled{{/disabled}}>
                            {{buttontext}}
                        </button>
                    </form>
                </div>
            </div>
        {{/items}}
    </div>
</div>
